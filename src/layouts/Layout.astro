---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import { site } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  /** Ruta canónica relativa, ej. "/servicios/pulido-de-hormigon" */
  canonical?: string;
  /** Oculta header/footer (útil para previews aislados) */
  bare?: boolean;
  /** Oculta el botón flotante de WhatsApp (páginas con formulario en móvil) */
  whatsappFloat?: boolean;
  /** noindex para esta página concreta (ej. blog placeholder) */
  noindex?: boolean;
}

const {
  title = `${site.name} — Pulido y tratamiento de pavimentos en Andalucía`,
  description = site.description,
  canonical,
  bare = false,
  whatsappFloat = true,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(canonical ?? Astro.url.pathname, site.url);
const ogImage = new URL("/og.jpg", site.url);

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.name,
  description: site.description,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  image: ogImage.href,
  priceRange: "€€",
  address: {
    "@type": "PostalAddress",
    addressLocality: site.baseCity,
    addressRegion: "Córdoba",
    addressCountry: "ES",
  },
  geo: { "@type": "GeoCoordinates", latitude: 37.6736, longitude: -4.9296 },
  areaServed: site.cities.map((c) => ({ "@type": "City", name: c.name })),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Tipografía corporativa: Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />

    {/* Mientras site.indexable sea false, la web NO se indexa en buscadores */}
    {(!site.indexable || noindex) && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage.href} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-800 antialiased">
    {!bare && <Header />}
    <main class="flex-1">
      <slot />
    </main>
    {!bare && <Footer />}
    {!bare && whatsappFloat && <WhatsAppFloat />}
  </body>
</html>
