---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import CTASection from "../components/CTASection.astro";
import { site, surfaces, whatsappHref } from "../config/site";

export const prerender = true;

const title = "Sobre nosotros — Pulimentos y Aplicaciones Jiménez";
const description =
  "Somos especialistas en pulido, cristalizado y tratamiento de suelos. Desde La Carlota (Córdoba) trabajamos en toda Andalucía con maquinaria diamantada propia.";
---

<Layout title={title} description={description} canonical="/sobre-nosotros">
  <!-- HERO -->
  <section class="bg-brand-900 text-white">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-6 py-20 lg:grid-cols-2">
      <div>
        <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-5xl">
          Sobre nosotros
        </h1>
        <p class="mt-6 text-lg text-brand-100">
          Somos <strong>{site.name}</strong>, especialistas en pulidos y
          tratamientos de suelos. Trabajamos desde {site.baseCity} (Córdoba) y
          nos desplazamos por toda Andalucía: viviendas, comunidades, naves
          industriales, hoteles y hospitales.
        </p>
        <p class="mt-4 text-lg font-medium italic text-brand-200">
          «Innovación en cada acabado, un brillo para siempre»
        </p>
      </div>
      <img
        src="/proyectos/equipo-camiseta.webp"
        alt="Operario de Pulimentos Jiménez, con la camiseta de la empresa, tratando un suelo de barro cocido"
        loading="eager"
        class="max-h-[440px] w-full rounded-3xl object-cover shadow-2xl ring-1 ring-white/20"
      />
    </div>
  </section>

  <!-- POR QUÉ ELEGIRNOS -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">Por qué elegirnos</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-xl border border-slate-200 bg-white p-6">
        <h3 class="font-semibold text-slate-900">Maquinaria propia</h3>
        <p class="mt-2 text-sm text-slate-600">
          Pulidoras y herramienta diamantada de última generación, siempre a punto.
        </p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-6">
        <h3 class="font-semibold text-slate-900">Todo tipo de suelos</h3>
        <p class="mt-2 text-sm text-slate-600">
          Hormigón, mármol, terrazo, barro cocido, epoxi y más. Cada material, su tratamiento.
        </p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-6">
        <h3 class="font-semibold text-slate-900">Presupuesto sin compromiso</h3>
        <p class="mt-2 text-sm text-slate-600">
          Valoramos tu suelo y te asesoramos gratis. Para naves, prueba gratuita in situ.
        </p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-6">
        <h3 class="font-semibold text-slate-900">Toda Andalucía</h3>
        <p class="mt-2 text-sm text-slate-600">
          Base en {site.baseCity} (Córdoba) y desplazamiento a Córdoba, Sevilla, Málaga y Jaén.
        </p>
      </div>
    </div>
  </section>

  <!-- EL TRABAJO HABLA -->
  <section class="border-y border-slate-200 bg-slate-50 py-16">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <img
          src="/proyectos/equipo-garaje.webp"
          alt="El equipo de Pulimentos Jiménez con clientes sobre un garaje de hormigón pulido con acabado espejo"
          loading="lazy"
          class="max-h-[420px] w-full rounded-3xl object-cover shadow-lg ring-1 ring-slate-200"
        />
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-slate-900">
            El resultado habla por nosotros
          </h2>
          <p class="mt-4 text-slate-600">
            Cada suelo que tratamos sale con nombre y apellidos: el nuestro.
            Trabajamos con la misma exigencia un garaje particular que el hall
            de un hotel o la solera de una nave industrial.
          </p>
          <p class="mt-3 text-slate-600">
            En nuestra galería puedes ver trabajos reales, con fotos reales,
            sin retoques.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <Button href="/proyectos">Ver trabajos reales</Button>
            <Button href={whatsappHref} variant="ghost">💬 WhatsApp</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SUPERFICIES -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">Superficies que tratamos</h2>
    <div class="mt-6 flex flex-wrap gap-3">
      {
        surfaces.map((s) => (
          <span class="rounded-full bg-brand-50 px-4 py-2 text-sm font-medium text-brand-800">
            {s}
          </span>
        ))
      }
    </div>
  </section>

  <CTASection />
</Layout>
