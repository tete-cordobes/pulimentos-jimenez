---
import Layout from "../../layouts/Layout.astro";
import CTASection from "../../components/CTASection.astro";
import { getCollection } from "astro:content";

export const prerender = true;

// Los posts son Markdown en src/content/blog/ (ver src/content.config.ts).
// Se listan del más reciente al más antiguo; los borradores no salen.
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const formatoFecha = new Intl.DateTimeFormat("es-ES", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Layout
  title="Blog: pulido, litio y tratamiento de suelos | Pulimentos Jiménez"
  description="Guías claras sobre tratamiento de litio, pulido, cristalizado y vitrificado. Lo que preguntan antes de pedir presupuesto."
  canonical="/blog"
>
  <section class="bg-brand-900 text-white">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-5xl">Blog</h1>
      <p class="mt-4 max-w-2xl text-lg text-brand-100">
        Guías de suelo, sin relleno: qué tratamiento te conviene y de qué depende el precio.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-20">
    {
      posts.length === 0 ? (
        <p class="rounded-xl bg-slate-100 px-6 py-10 text-center text-slate-600">
          🚧 El blog estará disponible muy pronto. Estamos preparando contenido útil
          sobre pulido de hormigón, cristalizado de mármol, precios por m² y más.
        </p>
      ) : (
        <ul class="space-y-8">
          {posts.map((post) => (
            <li class="rounded-xl border border-slate-200 bg-white p-6 transition hover:border-brand-300 hover:shadow-sm">
              <p class="text-sm text-slate-500">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatoFecha.format(post.data.pubDate)}
                </time>
              </p>
              <h2 class="mt-2 text-xl font-bold tracking-tight text-slate-900">
                <a href={`/blog/${post.id}/`} class="hover:text-brand-700">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 text-slate-600">{post.data.description}</p>
              <a
                href={`/blog/${post.id}/`}
                class="mt-4 inline-block text-sm font-semibold text-brand-700 hover:text-brand-800"
              >
                Leer el artículo →
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <CTASection />
</Layout>
