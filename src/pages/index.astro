---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { site, telHref, whatsappHref } from "../config/site";
import { servicesContent } from "../data/services";
import LogoCarousel from "../components/LogoCarousel.astro";

// Home estática provisional (design system). En la Fase 4/5 puede pasar a Storyblok.
export const prerender = true;
---

<Layout>
  <!-- HERO: foto real limpia a sangre + caja de texto -->
  <section class="relative isolate flex min-h-[85vh] items-center overflow-hidden">
    <!-- Foto de fondo (suelo de hormigón pulido con acabado espejo) -->
    <img
      src="/proyectos/hero-foto.webp"
      alt="Suelo de hormigón pulido con acabado brillante tipo espejo"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
      style="object-position: center 45%"
    />
    <!-- Oscurecido muy sutil para dar profundidad -->
    <div class="absolute inset-0 -z-10 bg-black/15"></div>

    <!-- Hero según el mockup del cliente: el claim, grande y centrado sobre la foto -->
    <div class="mx-auto w-full max-w-4xl px-6 py-20 text-center">
      <!-- Caja "cristal esmerilado" (estilo E3): translúcida, deja ver la foto -->
      <div class="rounded-3xl bg-white/10 p-8 text-white shadow-2xl ring-1 ring-white/25 backdrop-blur-xl sm:p-12">
        <p class="mb-5 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-brand-100 ring-1 ring-white/15 backdrop-blur sm:tracking-widest">
          Especialistas en tratamiento de suelos
        </p>
        <h1 class="text-balance text-4xl font-semibold leading-[1.12] tracking-tight sm:text-5xl lg:text-6xl">
          Soluciones integrales para
          <span class="block">todo tipo de pavimentos</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-pretty text-lg text-brand-100 sm:text-xl">
          Devolvemos la vida a tus suelos: pulido, cristalizado y tratamiento
          de pavimentos. Disponemos de todo tipo de maquinaria, adaptándonos a
          tus necesidades, en toda Andalucía.
        </p>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <Button href="/contacto" variant="secondary">Pide presupuesto gratis</Button>
          <Button
            href={whatsappHref}
            variant="ghost"
            class="border border-white/30 text-white hover:bg-white/10"
          >
            💬 WhatsApp
          </Button>
        </div>
        <p class="mt-6 text-sm text-brand-100/90">
          ¿Prefieres llamar?{" "}
          <a href={telHref} class="font-semibold text-white underline underline-offset-4">
            {site.phone}
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- CLIENTES: carrusel de logos, justo bajo el hero (confianza inmediata) -->
  <LogoCarousel />

  <!-- BARRA DE CONFIANZA -->
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-6 px-6 py-10 text-center sm:grid-cols-4">
      <div>
        <p class="text-3xl font-bold text-brand-900">Gratis</p>
        <p class="text-sm text-slate-600">presupuesto sin compromiso</p>
      </div>
      <div>
        <p class="text-3xl font-bold text-brand-900">+30</p>
        <p class="text-sm text-slate-600">años de experiencia</p>
      </div>
      <div>
        <p class="text-3xl font-bold text-brand-900">8+</p>
        <p class="text-sm text-slate-600">tipos de pavimento</p>
      </div>
      <div>
        <p class="text-3xl font-bold text-brand-900">100%</p>
        <p class="text-sm text-slate-600">maquinaria propia</p>
      </div>
    </div>
  </section>

  <!-- QUIÉNES SOMOS: la "leyenda" de la empresa (texto del cliente) -->
  <section class="mx-auto max-w-4xl px-6 py-20">
    <div class="text-center">
      <p class="inline-flex items-center gap-2 rounded-full bg-brand-50 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-brand-700">
        Más de 30 años de experiencia
      </p>
      <h2 class="mt-5 text-balance text-3xl font-bold tracking-tight text-slate-900">
        Especialistas en el cuidado y tratamiento de tus suelos
      </h2>
    </div>
    <div class="mx-auto mt-8 max-w-3xl text-pretty text-lg leading-relaxed text-slate-600">
      <p>
        Somos especialistas en el desbastado, pulido diamantado, abrillantado,
        cristalizado, vitrificado y abujardado de todo tipo de pavimentos —
        además de la recuperación con nano-litio para hormigón y las
        aplicaciones de epoxi. Más de tres décadas dando soluciones de alta
        calidad, tanto a suelos antiguos como nuevos, con acabados resistentes
        pensados para perdurar. Disponemos de maquinaria propia, monofásica y
        trifásica, para adaptarnos a cada trabajo.
      </p>
    </div>
    <div class="mt-8 text-center">
      <Button href="/sobre-nosotros">Conócenos</Button>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="mx-auto max-w-7xl px-6 pb-20">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900">Nuestros servicios</h2>
      <p class="mt-4 text-slate-600">
        Restauramos, pulimos y recuperamos todo tipo de suelos y escaleras con
        herramienta diamantada y los mejores productos del mercado.
      </p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {servicesContent.map((s) => <ServiceCard slug={s.slug} name={s.name} short={s.short} image={s.image} imageAlt={s.imageAlt} />)}
    </div>
  </section>

  <!-- ANTES / DESPUÉS (fotos reales: media zona tratada, media sin tratar) -->
  <section class="border-y border-slate-200 bg-slate-50 py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900">
          El antes y el después, en una sola foto
        </h2>
        <p class="mt-4 text-slate-600">
          Sin retoques y sin trucos: en mitad del trabajo, la diferencia se ve
          sola. Suelo de barro cocido de un hotel durante el tratamiento.
        </p>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <figure class="overflow-hidden rounded-3xl bg-white shadow-lg ring-1 ring-slate-200">
          <img
            src="/proyectos/barro-prueba-antes-despues.webp"
            alt="Prueba demostrativa sobre suelo de terracota: las losas del centro ya tratadas, brillantes y con el color recuperado, rodeadas del barro crudo y apagado tal y como estaba"
            loading="lazy"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="p-5 text-sm text-slate-600">
            Prueba demostrativa hecha in situ para el cliente: las losas del
            centro, ya tratadas, brillan con su color recuperado; alrededor, la
            terracota cruda tal y como estaba. Sin retoques.
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-3xl bg-white shadow-lg ring-1 ring-slate-200">
          <img
            src="/proyectos/barro-hotel-operario.webp"
            alt="Operario de Pulimentos Jiménez aplicando a mano el tratamiento sobre el barro cocido"
            loading="lazy"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="p-5 text-sm text-slate-600">
            Aplicado a mano, metro a metro. Así se trabaja un suelo para que el
            brillo dure años.
          </figcaption>
        </figure>
      </div>
      <div class="mt-10 text-center">
        <Button href="/proyectos">Ver más trabajos reales</Button>
      </div>
    </div>
  </section>


  <!-- CTA FINAL -->
  <section class="bg-brand-900 text-white">
    <div class="mx-auto flex max-w-7xl flex-col items-center gap-6 px-6 py-16 text-center">
      <h2 class="text-3xl font-bold tracking-tight">
        ¿Tienes un suelo que recuperar?
      </h2>
      <p class="max-w-xl text-brand-100">
        Solicita tu presupuesto y asesoramiento sin compromiso. Para naves
        industriales, ofrecemos prueba gratuita in situ.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <Button href="/contacto" variant="secondary">Pedir presupuesto</Button>
        <Button href="/calculadora-precio" variant="ghost" class="text-white hover:bg-brand-800">
          Calcular precio por m²
        </Button>
      </div>
    </div>
  </section>
</Layout>
