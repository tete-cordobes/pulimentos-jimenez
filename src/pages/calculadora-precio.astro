---
import Layout from "../layouts/Layout.astro";
import { telHref } from "../config/site";

export const prerender = true;

// Rangos orientativos €/m² por servicio (estimación, NO vinculante).
// Ajustar con datos reales de Pulimentos Jiménez.
const rates = [
  { id: "hormigon", label: "Pulido de hormigón", min: 15, max: 30 },
  { id: "epoxi", label: "Pavimento de resina epoxi", min: 20, max: 40 },
  { id: "marmol", label: "Pulido / cristalizado de mármol", min: 12, max: 25 },
  { id: "terrazo", label: "Pulido de terrazo", min: 12, max: 22 },
  { id: "abrillantado", label: "Abrillantado de suelos", min: 8, max: 15 },
  { id: "vitrificado", label: "Vitrificado", min: 10, max: 20 },
  { id: "abujardado", label: "Abujardado de hormigón", min: 15, max: 30 },
];
---

<Layout
  title="Calculadora de precio por m² de pulido de suelos — Pulimentos Jiménez"
  description="Calcula online el precio orientativo del pulido o tratamiento de tu suelo por m². Hormigón, mármol, terrazo, epoxi. Presupuesto exacto sin compromiso."
  canonical="/calculadora-precio"
>
  <section class="bg-brand-900 text-white">
    <div class="mx-auto max-w-4xl px-6 py-16 text-center">
      <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-5xl">
        Calculadora de precio por m²
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-brand-100">
        Haz una estimación rápida del coste de pulir o tratar tu suelo. Para un
        presupuesto exacto y sin compromiso, te lo preparamos a medida.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="calc-servicio" class="block text-sm font-medium text-slate-700">Tipo de tratamiento</label>
          <select id="calc-servicio" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
            {rates.map((r) => <option value={r.id} data-min={r.min} data-max={r.max}>{r.label}</option>)}
          </select>
        </div>
        <div>
          <label for="calc-metros" class="block text-sm font-medium text-slate-700">Superficie (m²)</label>
          <input id="calc-metros" type="number" min="1" value="50" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
        </div>
      </div>

      <div id="calc-resultado" class="mt-8 rounded-xl bg-brand-50 p-6 text-center">
        <p class="text-sm text-brand-700">Estimación orientativa</p>
        <p id="calc-precio" class="mt-1 text-3xl font-bold text-brand-900">—</p>
        <p class="mt-1 text-xs text-slate-500">
          Precio no vinculante. El presupuesto final depende del estado del suelo
          y el acabado.
        </p>
      </div>

      <a
        href="/contacto"
        class="mt-6 flex w-full items-center justify-center rounded-lg bg-brand px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-800"
      >
        Quiero un presupuesto exacto
      </a>
      <p class="mt-3 text-center text-sm text-slate-500">
        o llámanos al <a href={telHref} class="font-semibold text-brand-700">teléfono</a>
      </p>
    </div>
  </section>
</Layout>

<script>
  const servicio = document.getElementById("calc-servicio") as HTMLSelectElement | null;
  const metros = document.getElementById("calc-metros") as HTMLInputElement | null;
  const precio = document.getElementById("calc-precio");

  const fmt = new Intl.NumberFormat("es-ES", {
    style: "currency",
    currency: "EUR",
    maximumFractionDigits: 0,
  });

  function calcular() {
    if (!servicio || !metros || !precio) return;
    const opt = servicio.selectedOptions[0];
    const min = Number(opt.dataset.min);
    const max = Number(opt.dataset.max);
    const m = Math.max(0, Number(metros.value) || 0);
    if (m <= 0) {
      precio.textContent = "—";
      return;
    }
    precio.textContent = `${fmt.format(m * min)} – ${fmt.format(m * max)}`;
  }

  servicio?.addEventListener("change", calcular);
  metros?.addEventListener("input", calcular);
  calcular();
</script>
