---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import FAQ from "../../components/FAQ.astro";
import CTASection from "../../components/CTASection.astro";
import { servicesContent, type ServiceContent } from "../../data/services";
import { site, surfaces as allSurfaces, whatsappHref } from "../../config/site";

export const prerender = true;

export function getStaticPaths() {
  return servicesContent.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceContent;
}

const { service } = Astro.props;
const canonical = `/servicios/${service.slug}`;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.name,
  serviceType: service.name,
  provider: { "@type": "LocalBusiness", name: site.name, url: site.url },
  areaServed: site.cities.map((c) => ({ "@type": "City", name: c.name })),
  description: service.metaDescription,
  url: new URL(canonical, site.url).href,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: site.url },
    { "@type": "ListItem", position: 2, name: "Servicios", item: new URL("/servicios", site.url).href },
    { "@type": "ListItem", position: 3, name: service.name, item: new URL(canonical, site.url).href },
  ],
};

const surfaces = service.surfaces ?? allSurfaces;
---

<Layout title={service.metaTitle} description={service.metaDescription} canonical={canonical}>
  <!-- HERO: texto + foto REAL del trabajo (cuando hay foto del material correcto) -->
  <section class="bg-brand-900 text-white">
    <div
      class:list={[
        "mx-auto grid max-w-7xl items-center gap-10 px-6 py-20",
        service.image && "lg:grid-cols-2",
      ]}
    >
      <div class:list={[!service.image && "mx-auto max-w-4xl"]}>
        <nav class="mb-4 text-sm text-brand-200">
          <a href="/" class="hover:text-white">Inicio</a> ·
          <a href="/servicios" class="hover:text-white">Servicios</a> · {service.name}
        </nav>
        <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-5xl">
          {service.h1}
        </h1>
        <div class="mt-6 space-y-4 text-lg text-brand-100">
          {service.intro.map((p) => <p>{p}</p>)}
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/contacto" variant="secondary">Pide presupuesto</Button>
          <Button href={whatsappHref} variant="ghost" class="text-white hover:bg-brand-800">
            💬 WhatsApp
          </Button>
        </div>
      </div>
      {
        service.image && (
          <img
            src={service.image}
            alt={service.imageAlt ?? `Trabajo real de ${service.name} — Pulimentos Jiménez`}
            loading="eager"
            class="max-h-[440px] w-full rounded-3xl object-cover shadow-2xl ring-1 ring-white/20"
          />
        )
      }
    </div>
  </section>

  <!-- BENEFICIOS -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">Ventajas</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        service.benefits.map((b) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <h3 class="font-semibold text-slate-900">{b.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{b.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- PROCESO -->
  <section class="border-y border-slate-200 bg-slate-50 py-16">
    <div class="mx-auto max-w-7xl px-6">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Cómo trabajamos</h2>
      <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          service.process.map((step, i) => (
            <li class="rounded-xl bg-white p-6 ring-1 ring-slate-200">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand text-sm font-bold text-white">
                {i + 1}
              </span>
              <h3 class="mt-3 font-semibold text-slate-900">{step.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{step.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- SUPERFICIES -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">Superficies que tratamos</h2>
    <div class="mt-6 flex flex-wrap gap-3">
      {
        surfaces.map((s) => (
          <span class="rounded-full bg-brand-50 px-4 py-2 text-sm font-medium text-brand-800">
            {s}
          </span>
        ))
      }
    </div>
  </section>

  <FAQ faqs={service.faqs} />

  <CTASection />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>
