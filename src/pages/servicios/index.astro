---
import Layout from "../../layouts/Layout.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import CTASection from "../../components/CTASection.astro";
import { servicesContent } from "../../data/services";

export const prerender = true;

const title = "Servicios de pulido y tratamiento de suelos — Pulimentos Jiménez";
const description =
  "Pulido de hormigón, pavimentos de epoxi, cristalizado de mármol, terrazo y más. Tratamientos de suelos en Córdoba, Málaga, Sevilla, Jaén y Granada.";
---

<Layout title={title} description={description} canonical="/servicios">
  <section class="bg-brand-900 text-white">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-6 py-20 lg:grid-cols-2">
      <div>
        <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-5xl">
          Nuestros servicios
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-brand-100">
          Restauramos, pulimos y recuperamos todo tipo de suelos y escaleras con
          herramienta diamantada de última generación.
        </p>
      </div>
      <img
        src="/proyectos/garaje-hexagonal.webp"
        alt="Garaje con suelo de hormigón pulido reflejando la iluminación hexagonal del techo — trabajo real de Pulimentos Jiménez"
        loading="eager"
        class="max-h-[400px] w-full rounded-3xl object-cover shadow-2xl ring-1 ring-white/20"
      />
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        servicesContent.map((s) => (
          <ServiceCard slug={s.slug} name={s.name} short={s.short} image={s.image} imageAlt={s.imageAlt} />
        ))
      }
    </div>
  </section>

  <CTASection />
</Layout>
