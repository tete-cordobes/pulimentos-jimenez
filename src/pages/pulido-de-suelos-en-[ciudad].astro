---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import ServiceCard from "../components/ServiceCard.astro";
import FAQ from "../components/FAQ.astro";
import CTASection from "../components/CTASection.astro";
import { citiesContent, type CityContent } from "../data/cities";
import { townsContent } from "../data/towns";
import { orderedServices } from "../data/services";
import { site, whatsappHref } from "../config/site";

export const prerender = true;

export function getStaticPaths() {
  // Capitales (cities.ts) + municipios (towns.ts) generan /pulido-de-suelos-en-[slug]
  return [...citiesContent, ...townsContent].map((city) => ({
    params: { ciudad: city.slug },
    props: { city },
  }));
}

interface Props {
  city: CityContent;
}

const { city } = Astro.props;
const canonical = `/pulido-de-suelos-en-${city.slug}`;
// Enlazado interno: municipios hijos si es capital; enlace a la capital si es municipio.
const childTowns = townsContent.filter((t) => t.parentSlug === city.slug);
const isTown = Boolean(city.parentSlug);
// Mapa nombre -> slug de TODAS las páginas de zona, para enlazar los "nearby"
// que tengan página propia (enlazado interno horizontal).
const slugByName = new Map(
  [...citiesContent, ...townsContent].map((c) => [c.name, c.slug]),
);

// Una sola identidad estable (misma NAP en todas las páginas). La zona de
// cada location page se expresa con areaServed, no cambiando el name.
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${site.url}/#business`,
  name: site.name,
  description: city.metaDescription,
  url: new URL(canonical, site.url).href,
  telephone: site.phone,
  email: site.email,
  image: new URL("/og.jpg", site.url).href,
  priceRange: "€€",
  address: {
    "@type": "PostalAddress",
    streetAddress: site.addressStreet,
    postalCode: site.addressPostal,
    addressLocality: site.addressLocality,
    addressRegion: site.addressRegion,
    addressCountry: "ES",
  },
  areaServed: [
    { "@type": "City", name: city.name },
    ...city.nearby.map((n) => ({ "@type": "Place", name: n })),
  ],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: site.url },
    { "@type": "ListItem", position: 2, name: city.h1, item: new URL(canonical, site.url).href },
  ],
};
---

<Layout title={city.metaTitle} description={city.metaDescription} canonical={canonical}>
  <!-- HERO -->
  <section class="bg-brand-900 text-white">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-5xl">
        {city.h1}
      </h1>
      <div class="mt-6 space-y-4 text-lg text-brand-100">
        {city.intro.map((p) => <p>{p}</p>)}
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/contacto" variant="secondary">Pide presupuesto</Button>
        <Button href={whatsappHref} variant="ghost" class="text-white hover:bg-brand-800">
          💬 WhatsApp
        </Button>
      </div>
    </div>
  </section>

  <!-- SERVICIOS EN LA CIUDAD -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">
      Servicios de pulido en {city.name}
    </h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        orderedServices.map((s) => (
          <ServiceCard slug={s.slug} name={s.name} short={s.short} />
        ))
      }
    </div>
  </section>

  <!-- ZONAS -->
  <section class="border-y border-slate-200 bg-slate-50 py-16">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">
        Zonas donde trabajamos cerca de {city.name}
      </h2>
      <div class="mt-6 flex flex-wrap gap-3">
        {
          city.nearby.map((n) => {
            const slug = slugByName.get(n);
            return slug ? (
              <a
                href={`/pulido-de-suelos-en-${slug}`}
                class="rounded-full bg-white px-4 py-2 text-sm font-medium text-brand-700 ring-1 ring-brand-200 transition hover:bg-brand-50"
              >
                {n}
              </a>
            ) : (
              <span class="rounded-full bg-white px-4 py-2 text-sm font-medium text-slate-700 ring-1 ring-slate-200">
                {n}
              </span>
            );
          })
        }
      </div>
    </div>
  </section>

  {/* ENLAZADO INTERNO: capital → sus municipios */}
  {
    childTowns.length > 0 && (
      <section class="mx-auto max-w-4xl px-6 py-16">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">
          Municipios donde trabajamos en la provincia de {city.name}
        </h2>
        <p class="mt-3 text-slate-600">
          Además de {city.name} capital, damos servicio de pulido y tratamiento de suelos en:
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          {childTowns.map((t) => (
            <a
              href={`/pulido-de-suelos-en-${t.slug}`}
              class="rounded-full bg-brand-50 px-4 py-2 text-sm font-medium text-brand-700 ring-1 ring-brand-100 transition hover:bg-brand-100"
            >
              {t.name}
            </a>
          ))}
        </div>
      </section>
    )
  }

  {/* ENLAZADO INTERNO: municipio → su capital */}
  {
    isTown && (
      <section class="mx-auto max-w-4xl px-6 py-16">
        <div class="rounded-2xl bg-slate-50 p-8 ring-1 ring-slate-200">
          <h2 class="text-xl font-bold tracking-tight text-slate-900">
            Trabajamos en toda la provincia de {city.parentName}
          </h2>
          <p class="mt-3 text-slate-600">
            {city.name} forma parte de nuestra zona de {city.parentName}. Consulta también nuestra página de
            <a
              href={`/pulido-de-suelos-en-${city.parentSlug}`}
              class="font-semibold text-brand-700 underline underline-offset-2"
            >
              {" "}pulido de suelos en {city.parentName}
            </a>{" "}
            para ver todos los servicios y zonas.
          </p>
        </div>
      </section>
    )
  }

  <FAQ faqs={city.faqs} title={`Preguntas frecuentes — ${city.name}`} />

  <CTASection title={`¿Necesitas pulir un suelo en ${city.name}?`} />

  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>
