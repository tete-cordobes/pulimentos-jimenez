---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import ServiceCard from "../components/ServiceCard.astro";
import FAQ from "../components/FAQ.astro";
import CTASection from "../components/CTASection.astro";
import { citiesContent, type CityContent } from "../data/cities";
import { townsContent } from "../data/towns";
import { orderedServices } from "../data/services";
import { site, whatsappHref } from "../config/site";

export const prerender = true;

export function getStaticPaths() {
  // Capitales (cities.ts) + municipios (towns.ts) generan /pulido-de-suelos-en-[slug]
  return [...citiesContent, ...townsContent].map((city) => ({
    params: { ciudad: city.slug },
    props: { city },
  }));
}

interface Props {
  city: CityContent;
}

const { city } = Astro.props;
const canonical = `/pulido-de-suelos-en-${city.slug}`;
// Enlazado interno: municipios hijos si es capital; enlace a la capital si es municipio.
const childTowns = townsContent.filter((t) => t.parentSlug === city.slug);
const isTown = Boolean(city.parentSlug);
// Mapa nombre -> slug de TODAS las páginas de zona, para enlazar los "nearby"
// que tengan página propia (enlazado interno horizontal).
const slugByName = new Map(
  [...citiesContent, ...townsContent].map((c) => [c.name, c.slug]),
);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: site.url },
    { "@type": "ListItem", position: 2, name: city.h1, item: new URL(canonical, site.url).href },
  ],
};
---

<Layout title={city.metaTitle} description={city.metaDescription} canonical={canonical}>
  <!-- HERO -->
  <section class="bg-brand-900 text-white">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-5xl">
        {city.h1}
      </h1>
      <div class="mt-6 space-y-4 text-lg text-brand-100">
        {city.intro.map((p) => <p>{p}</p>)}
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/contacto" variant="secondary">Pide presupuesto</Button>
        <Button href={whatsappHref} variant="ghost" class="text-white hover:bg-brand-800">
          💬 WhatsApp
        </Button>
      </div>
    </div>
  </section>

  <!-- SERVICIOS EN LA CIUDAD -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">
      Servicios de pulido en {city.name}
    </h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        orderedServices.map((s) => (
          <ServiceCard slug={s.slug} name={s.name} short={s.short} />
        ))
      }
    </div>
  </section>

  {city.slug === "cordoba" && (
    <section class="mx-auto max-w-7xl px-6 pb-16">
      <h2 class="text-2xl font-bold text-slate-900">Pulido y abrillantado de suelos en Córdoba capital</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {[
          ["Pulido de mármol en Córdoba", "Restauración de piedra natural, reparación de coqueras, afinado y cristalizado en viviendas y edificios."],
          ["Pulido de terrazo en Córdoba", "Recuperación de pavimentos antiguos y desgastados en colegios, portales y comunidades."],
          ["Pulido de hormigón en Córdoba", "Pulido diamantado, densificación con silicatos y sellado de soleras industriales según su uso."],
          ["Abrillantado de suelos en Córdoba", "Valoramos si basta un abrillantado o si es necesario pulir primero para eliminar marcas y desgaste."],
        ].map(([heading, description]) => (
          <div class="rounded-xl border border-slate-200 p-6">
            <h3 class="text-xl font-semibold text-slate-900">{heading}</h3>
            <p class="mt-3 text-slate-600">{description}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 grid items-center gap-6 sm:grid-cols-2">
        <img src="/images/blog/ministerios.jpeg" alt="Mármol restaurado y abrillantado en el edificio de los Ministerios de Córdoba" loading="lazy" class="w-full rounded-xl object-cover" />
        <div>
          <h2 class="text-xl font-bold text-slate-900">Trabajo realizado: edificio de los Ministerios de Córdoba</h2>
          <p class="mt-3 text-slate-600">Recuperación de 500 m² de mármol crema marfil de los años 70, conservando la solería original mediante reparación, afinado y cristalizado.</p>
          <a href="/blog/" class="mt-4 inline-block font-semibold text-brand-700 underline">Consulta nuestros trabajos en el blog</a>
        </div>
      </div>
    </section>
  )}

  {city.slug === "malaga" && (
    <section class="mx-auto max-w-7xl px-6 pb-16">
      <div class="grid gap-8 sm:grid-cols-2">
        <div>
          <h2 class="text-xl font-bold tracking-tight text-slate-900">Pulido de mármol en Málaga</h2>
          <p class="mt-3 text-slate-600">Pulimos suelos de mármol desgastados y aplicamos el acabado adecuado al pavimento. Trabajamos en entradas de hoteles, portales de comunidades y viviendas.</p>
        </div>
        <div>
          <h2 class="text-xl font-bold tracking-tight text-slate-900">Abrillantado de suelos en Málaga</h2>
          <p class="mt-3 text-slate-600">Si el suelo ha perdido brillo pero está en buen estado, valoramos un abrillantado. Cuando hay rayas profundas o desgaste desigual, puede convenir pulir antes de aplicar el acabado.</p>
        </div>
        <div>
          <h2 class="text-xl font-bold tracking-tight text-slate-900">Pulido de terrazo en Málaga</h2>
          <p class="mt-3 text-slate-600">Restauramos y abrillantamos pavimentos de terrazo en colegios, comunidades y otros edificios. Entre nuestros proyectos está el terrazo de más de 40 años del CEIP Beato Juan de Ávila de Montilla, con 2.400 m² de superficie a tratar.</p>
        </div>
        <div>
          <h2 class="text-xl font-bold tracking-tight text-slate-900">Pulido de hormigón en Málaga</h2>
          <p class="mt-3 text-slate-600">Pulimos y tratamos soleras de hormigón para naves industriales, almacenes y locales. Valoramos el estado del suelo y el tránsito que soportará para definir el acabado.</p>
        </div>
        <div>
          <h2 class="text-xl font-bold tracking-tight text-slate-900">Pulido de mármol en Marbella</h2>
          <p class="mt-3 text-slate-600">Nos desplazamos a Marbella para pulir y abrillantar suelos de mármol en hoteles, villas y comunidades. Para valorar el trabajo, indícanos la superficie aproximada y envíanos fotos del pavimento.</p>
        </div>
      </div>
      <div class="mt-8">
        <Button href="/contacto" variant="secondary">Pide presupuesto</Button>
      </div>
    </section>
  )}

  {city.slug === "malaga" && (
    <section class="mx-auto max-w-7xl px-6 pb-16">
      <h2 class="text-2xl font-bold text-slate-900">Especialidades de pulido de suelos en Málaga</h2>
      <p class="mt-3 text-slate-600">Soluciones para constructoras, naves industriales, particulares y comunidades de propietarios.</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {[
          { href: "/pulido-de-hormigon-en-malaga", title: "Pulido de hormigón industrial en Málaga", text: "Naves, almacenes y locales comerciales." },
          { href: "/pulido-de-marmol-en-malaga", title: "Pulido de mármol en Málaga", text: "Viviendas, hoteles y portales de comunidades." },
          { href: "/pulido-de-terrazo-en-malaga", title: "Pulido de terrazo en Málaga", text: "Restauración de pavimentos antiguos y zonas comunes." },
          { href: "/abrillantado-de-suelos-en-malaga", title: "Abrillantado de suelos en Málaga", text: "Tratamientos de brillo y mantenimiento." },
          { href: "/aplicacion-de-resina-epoxi-en-malaga/", title: "Aplicación de resina epoxi en Málaga", text: "Revestimientos para empresas y garajes." },
          { href: "/pulido-de-naves-industriales-en-malaga/", title: "Pulido de naves industriales en Málaga", text: "Recuperación de soleras." },
          { href: "/pavimentos-industriales-en-malaga/", title: "Pavimentos industriales en Málaga", text: "Selección de tratamientos." },
          { href: "/tratamiento-de-litio-en-pavimentos-en-malaga/", title: "Tratamiento de litio en Málaga", text: "Densificación del hormigón." },
          { href: "/pulido-de-escaleras-en-malaga/", title: "Pulido de escaleras en Málaga", text: "Mármol y terrazo." },
          { href: "/eliminacion-de-resina-epoxi-en-malaga/", title: "Eliminación de resina epoxi en Málaga", text: "Preparación mecánica del soporte." },
        ].map((item) => (
          <a href={item.href} class="block rounded-xl border border-slate-200 p-6 transition hover:border-brand-500 hover:bg-brand-50">
            <h3 class="font-semibold text-brand-800">{item.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{item.text}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {city.slug === "cordoba" && (
    <section class="mx-auto max-w-7xl px-6 pb-16">
      <h2 class="text-2xl font-bold text-slate-900">Especialidades de pulido en Córdoba</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {[
          ["pulido-de-marmol", "Pulido de mármol en Córdoba"],
          ["pulido-de-terrazo", "Pulido de terrazo en Córdoba"],
          ["abrillantado-de-suelos", "Abrillantado de suelos en Córdoba"],
          ["pulido-de-hormigon", "Pulido de hormigón en Córdoba"],
          ["aplicacion-de-resina-epoxi", "Aplicación de resina epoxi en Córdoba"],
          ["pulido-de-naves-industriales", "Pulido de naves industriales en Córdoba"],
          ["tratamiento-de-suelos-de-hormigon", "Tratamiento de suelos de hormigón en Córdoba"],
          ["pavimentos-industriales", "Pavimentos industriales en Córdoba"],
          ["tratamiento-de-litio-en-pavimentos", "Tratamiento de litio en pavimentos en Córdoba"],
          ["eliminacion-de-resina-epoxi", "Eliminación de resina epoxi en Córdoba"],
          ["pintado-de-garajes-y-parkings", "Pintado de garajes y parkings en Córdoba"],
          ["pulido-de-escaleras", "Pulido de escaleras en Córdoba"],
          ["restauracion-de-suelos-de-marmol", "Restauración de suelos de mármol en Córdoba"],
          ["tratamiento-de-barro-cocido", "Tratamiento de barro cocido en Córdoba"],
        ].map(([slug, title]) => (
          <a href={`/${slug}-en-cordoba/`} class="rounded-xl border border-slate-200 p-5 font-semibold text-brand-700 underline">{title}</a>
        ))}
      </div>
    </section>
  )}

  <!-- ZONAS -->
  <section class="border-y border-slate-200 bg-slate-50 py-16">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">
        Zonas donde trabajamos cerca de {city.name}
      </h2>
      <div class="mt-6 flex flex-wrap gap-3">
        {
          city.nearby.map((n) => (
            <span class="rounded-full bg-white px-4 py-2 text-sm font-medium text-slate-700 ring-1 ring-slate-200">
              {n}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  {/* ENLAZADO INTERNO: capital → sus municipios */}
  {
    childTowns.length > 0 && (
      <section class="mx-auto max-w-4xl px-6 py-16">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">
          Municipios donde trabajamos en la provincia de {city.name}
        </h2>
        <p class="mt-3 text-slate-600">
          Además de {city.name} capital, damos servicio de pulido y tratamiento de suelos en:
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          {childTowns.map((t) => (
            <a
              href={`/pulido-de-suelos-en-${t.slug}`}
              class="rounded-full bg-brand-50 px-4 py-2 text-sm font-medium text-brand-700 ring-1 ring-brand-100 transition hover:bg-brand-100"
            >
              {t.name}
            </a>
          ))}
        </div>
      </section>
    )
  }

  {/* ENLAZADO INTERNO: municipio → su capital */}
  {
    isTown && (
      <section class="mx-auto max-w-4xl px-6 py-16">
        <div class="rounded-2xl bg-slate-50 p-8 ring-1 ring-slate-200">
          <h2 class="text-xl font-bold tracking-tight text-slate-900">
            Trabajamos en toda la provincia de {city.parentName}
          </h2>
          <p class="mt-3 text-slate-600">
            {city.name} forma parte de nuestra zona de {city.parentName}. Consulta también nuestra página de
            <a
              href={`/pulido-de-suelos-en-${city.parentSlug}`}
              class="font-semibold text-brand-700 underline underline-offset-2"
            >
              {" "}pulido de suelos en {city.parentName}
            </a>{" "}
            para ver todos los servicios y zonas.
          </p>
        </div>
      </section>
    )
  }

  <FAQ faqs={city.faqs} title={`Preguntas frecuentes — ${city.name}`} />

  <CTASection title={`¿Necesitas pulir un suelo en ${city.name}?`} />

  <!-- La identidad LocalBusiness se declara una sola vez en Layout.astro. -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>
