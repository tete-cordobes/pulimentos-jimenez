---
import Layout from "../../layouts/Layout.astro";
import CTASection from "../../components/CTASection.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { useStoryblokApi } from "@storyblok/astro";
import {
  projects as fallbackProjects,
  surfaceFilters,
  type Project,
} from "../../data/projects";
import { gallery } from "../../data/gallery";

export const prerender = true;

// Galería de proyectos: los publicados por el cliente en Storyblok se
// FUSIONAN con los estáticos de src/data/projects.ts (los de Storyblok
// primero). Si un slug coincide, gana la versión de Storyblok.
let projects: Project[] = fallbackProjects;
try {
  const sbApi = useStoryblokApi();
  const { data } = await sbApi.get("cdn/stories", {
    content_type: "proyecto",
    version: "published",
    per_page: 100,
  });
  const stories = data?.stories ?? [];
  const sbProjects = stories.map((story: any): Project => ({
    slug: story.slug,
    title: story.content?.title || story.name,
    city: story.content?.city || undefined,
    surface: story.content?.surface ?? "Otros",
    before: story.content?.before?.filename || undefined,
    after: story.content?.after?.filename || undefined,
    videoUrl: story.content?.video_url || undefined,
    description: story.content?.description ?? "",
  }));
  const sbSlugs = new Set(sbProjects.map((p: Project) => p.slug));
  projects = [
    ...sbProjects,
    ...fallbackProjects.filter((p) => !sbSlugs.has(p.slug)),
  ];
} catch (err) {
  // Sin token o sin conexión a Storyblok → se muestra el fallback estático
  // (trabajos reales de Pulimentos Jiménez, ver src/data/projects.ts).
  console.warn("[proyectos] Storyblok no disponible, usando fallback:", err);
}
---

<Layout
  title="Proyectos y trabajos realizados — Pulimentos Jiménez"
  description="Galería de trabajos reales de pulido y tratamiento de pavimentos: hormigón, mármol, terrazo, barro y epoxi. Fotos reales, sin retoques."
  canonical="/proyectos"
>
  <!-- HERO -->
  <section class="bg-brand-900 text-white">
    <div class="mx-auto max-w-4xl px-6 py-16 text-center">
      <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-5xl">
        Nuestros proyectos
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-brand-100">
        Trabajos reales de pulido y tratamiento de suelos, con fotos sin
        retoques. El resultado habla por nosotros.
      </p>
    </div>
  </section>

  <!-- GALERÍA -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <!-- Filtros por tipo de suelo -->
    <div class="mb-10 flex flex-wrap justify-center gap-2" id="project-filters">
      {
        surfaceFilters.map((f, i) => (
          <button
            type="button"
            class:list={[
              "rounded-full px-4 py-2 text-sm font-medium transition",
              i === 0
                ? "bg-brand-700 text-white"
                : "bg-slate-100 text-slate-600 hover:bg-brand-50 hover:text-brand-700",
            ]}
            data-filter={f}
          >
            {f}
          </button>
        ))
      }
    </div>

    <!-- Tarjetas -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="project-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- GALERÍA VISUAL (mosaico de trabajos reales) -->
  <section class="border-t border-slate-200 bg-slate-50 py-16">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900">
          Galería de trabajos
        </h2>
        <p class="mt-4 text-slate-600">
          Una muestra de suelos que hemos pulido, cristalizado y tratado.
          Hormigón, mármol, terrazo, barro, epoxi, parkings y pistas: fotos
          reales, sin retoques.
        </p>
      </div>
      <div class="mt-12 gap-4 [column-fill:_balance] columns-2 md:columns-3 lg:columns-4">
        {
          gallery.map((photo) => (
            <figure class="mb-4 break-inside-avoid overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200">
              <img
                src={photo.src}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
                class="w-full object-cover transition duration-300 hover:scale-[1.03]"
              />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection />
</Layout>

<script>
  // Filtro por tipo de suelo (chips)
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-surface]");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter;

      // Estado visual de los chips
      buttons.forEach((b) => {
        const active = b === btn;
        b.classList.toggle("bg-brand-700", active);
        b.classList.toggle("text-white", active);
        b.classList.toggle("bg-slate-100", !active);
        b.classList.toggle("text-slate-600", !active);
      });

      // Mostrar/ocultar tarjetas
      cards.forEach((card) => {
        const show = filter === "Todos" || card.dataset.surface === filter;
        card.classList.toggle("hidden", !show);
      });
    });
  });
</script>
