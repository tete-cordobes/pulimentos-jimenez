---
import { site, services, telHref } from "../config/site";
import Button from "./Button.astro";

const nav = [
  { label: "Servicios", href: "/servicios" },
  { label: "Proyectos", href: "/proyectos" },
  { label: "Calculadora", href: "/calculadora-precio" },
  { label: "Blog", href: "/blog" },
  { label: "Contacto", href: "/contacto" },
];
---

<header class="sticky top-0 z-40 border-b border-brand-800 bg-brand-900/95 text-white backdrop-blur">
  <!-- Barra superior con teléfono (click-to-call) -->
  <div class="hidden border-b border-brand-800 bg-brand-900 text-white md:block">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-1.5 text-xs">
      <span class="text-brand-100">Pulido y tratamiento de pavimentos · Córdoba · Málaga · Sevilla · Jaén</span>
      <a href={telHref} class="font-semibold hover:text-brand-200">
        📞 {site.phone}
      </a>
    </div>
  </div>

  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-2.5" aria-label={site.name}>
      <svg
        class="h-9 w-9 shrink-0 text-white"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M3 8.5 L7 3.5 H17 L21 8.5 L12 21 Z" fill="currentColor" fill-opacity="0.12" />
        <path d="M3 8.5 H21 M7 3.5 L9.5 8.5 L12 21 M17 3.5 L14.5 8.5 L12 21 M9.5 8.5 H14.5" />
      </svg>
      <span class="flex flex-col leading-none">
        <span class="text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-brand-200">
          Pulimentos y Aplicaciones
        </span>
        <span class="text-xl font-extrabold tracking-tight text-white">JIMÉNEZ</span>
      </span>
    </a>

    <!-- Nav escritorio -->
    <div class="hidden items-center gap-8 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-brand-100 transition hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={telHref} class="text-sm font-semibold text-white hover:text-brand-200">
        {site.phone}
      </a>
      <Button href="/contacto" variant="secondary">Pide presupuesto</Button>
    </div>

    <!-- Botón menú móvil -->
    <button
      type="button"
      id="menu-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      class="lg:hidden"
    >
      <svg class="h-7 w-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Menú móvil -->
  <div id="mobile-menu" class="hidden border-t border-brand-800 bg-brand-900 px-6 py-4 lg:hidden">
    <div class="flex flex-col gap-1">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="rounded-md px-3 py-2 text-base font-medium text-brand-100 hover:bg-brand-800 hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
    </div>
    <div class="mt-4 flex flex-col gap-3">
      <a href={telHref} class="text-center text-sm font-semibold text-white">
        📞 {site.phone}
      </a>
      <Button href="/contacto" variant="secondary" class="w-full">Pide presupuesto</Button>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
