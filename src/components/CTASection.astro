---
import Button from "./Button.astro";

interface Props {
  title?: string;
  text?: string;
}

const {
  title = "¿Tienes un suelo que recuperar?",
  text = "Solicita tu presupuesto y asesoramiento sin compromiso. Para naves industriales, ofrecemos prueba gratuita in situ.",
} = Astro.props;
---

<section class="bg-brand-900 text-white">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-6 px-6 py-16 text-center">
    <h2 class="text-3xl font-bold tracking-tight">{title}</h2>
    <p class="max-w-xl text-brand-100">{text}</p>
    <div class="flex flex-wrap justify-center gap-3">
      <Button href="/contacto" variant="secondary">Pedir presupuesto</Button>
      <Button href="/calculadora-precio/" variant="ghost" class="text-white hover:bg-brand-800">
        Estimar presupuesto
      </Button>
    </div>
  </div>
</section>
