---
import { cn } from "../lib/cn";

interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  class?: string;
}

const { href, variant = "primary", class: className } = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-semibold transition focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2";

const variants = {
  primary: "bg-brand text-white hover:bg-brand-800",
  secondary: "bg-white text-brand-900 ring-1 ring-brand-200 hover:bg-brand-50",
  ghost: "text-brand-900 hover:bg-brand-50",
};
---

<a href={href} class={cn(base, variants[variant], className)}>
  <slot />
</a>
